<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MVVMUd.Views.Person2Page"
              xmlns:viewmodels="clr-namespace:MVVMUd.ViewModels"
             Title="Person2Page">
    
    <!--The Binding Context used here-->
    <ContentPage.BindingContext>
        <viewmodels:Person2ViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
    <VerticalStackLayout>

            <Entry Placeholder="Enter Name" Text="{Binding Name}"/>
            <Entry Placeholder="Enter City" Text="{Binding City}"/>
            <Entry Placeholder="Enter Age" Text="{Binding Age}"/>

            <Button Text="Show Details" Command="{Binding ShowDetailsCommand}" BackgroundColor="AliceBlue"/>
            <Button Text="Clear" Command="{Binding ClearCommand}" BackgroundColor="CadetBlue"/>
            <Button Text="Greet" Command="{Binding GreetCommand}" BackgroundColor="DarkSlateBlue"/>

            <Label Text="{Binding Message}" FontSize="18" TextColor="Red"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>